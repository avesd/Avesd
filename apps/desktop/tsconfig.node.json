{
  "extends": "@avesd/configuration/typescript/node",
  "compilerOptions": {
    "composite": true,
    "types": ["node", "electron"]
  },
  "include": [
    "electron.vite.config.ts",
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "test/*/main/**/*.ts",
    "test/*/preload/**/*.ts",
    "test/*/shared/**/*.ts"
  ]
}
